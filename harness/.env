# Inference provider: any OpenAI-compatible endpoint whose models support tool calling.
# Examples:
#   Fireworks:  https://api.fireworks.ai/inference/v1
#   Together:   https://api.together.xyz/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AUDIT_BASE_URL=https://api.fireworks.ai/inference/v1
AUDIT_API_KEY=fw_D8Z1QsFhnw2QocQnNR46fF
AUDIT_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017

# Provider name used for the Authorization header and providerOptions namespacing.
AUDIT_PROVIDER_NAME=Fireworks

# Optional per-criticality model overrides (fall back to AUDIT_MODEL when unset).
# AUDIT_MODEL_CRITICAL=
# AUDIT_MODEL_HIGH=
# AUDIT_MODEL_MEDIUM=
# AUDIT_MODEL_LOW=

# Execution controls.
AUDIT_CONCURRENCY=6
AUDIT_MAX_STEPS=60
AUDIT_TOKEN_BUDGET=320000

# Status written into audit-ledger.tsv when an item's review completes.
AUDIT_DONE_STATUS=done

# Virtual mount point the reviewer sees for the repository (translated to the
# real checkout at ../depot). Change only if you want a different illusion.
AUDIT_VIRTUAL_ROOT=/opt/depot
