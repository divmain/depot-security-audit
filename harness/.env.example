# Inference provider: any OpenAI-compatible endpoint whose models support tool calling.
# Examples:
#   Fireworks:  https://api.fireworks.ai/inference/v1
#   Together:   https://api.together.xyz/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AUDIT_BASE_URL=
AUDIT_API_KEY=
AUDIT_MODEL=

# Provider name used for the Authorization header and providerOptions namespacing.
AUDIT_PROVIDER_NAME=audit-provider

# Optional per-criticality model overrides (fall back to AUDIT_MODEL when unset).
# AUDIT_MODEL_CRITICAL=
# AUDIT_MODEL_HIGH=
# AUDIT_MODEL_MEDIUM=
# AUDIT_MODEL_LOW=

# Adversarial second stage: when a primary review reports finding_identified,
# this stronger model re-examines the finding adversarially (same read-only
# tools, different mandate: uphold / overstate / understate / refute / undecide).
# Leave AUDIT_ADVERSARY_MODEL empty to disable the second stage entirely.
AUDIT_ADVERSARY_MODEL=
AUDIT_ADVERSARY_REASONING_EFFORT=high
AUDIT_ADVERSARY_MAX_STEPS=40
AUDIT_ADVERSARY_TOKEN_BUDGET=200000

# Status written into audit-ledger.tsv between the primary review and the
# adversarial pass (only used when the adversarial stage is enabled).
AUDIT_PRELIMINARY_STATUS=preliminary_finding

# Execution controls. Concurrency is per model: each distinct model in use
# gets its own pool of AUDIT_CONCURRENCY slots (primary reviews, per-criticality
# overrides, and the adversarial pass all draw from their model's pool).
# Optional per-model caps, exact model IDs, comma-separated:
# AUDIT_CONCURRENCY_OVERRIDES=accounts/fireworks/models/glm-5p3=4
AUDIT_CONCURRENCY=8
AUDIT_MAX_STEPS=40
AUDIT_TOKEN_BUDGET=200000

# Status written into audit-ledger.tsv when an item's review completes.
AUDIT_DONE_STATUS=done

# Virtual mount point the reviewer sees for the repository (translated to the
# real checkout at ../depot). Change only if you want a different illusion.
AUDIT_VIRTUAL_ROOT=/opt/depot
